<?xml version="1.0"?>
<package format="3">
  <name>pico_ackermann_driver</name>
  <version>0.1.0</version>
  <description>ROS 2 USB serial driver and Pico firmware for Ackermann actuators.</description>
  <maintainer email="lucasfoulkes@gmail.com">Lucas Foulkes</maintainer>
  <license>MIT</license>

  <exec_depend>python3-serial</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
